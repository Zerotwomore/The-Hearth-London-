# Copy to .env.local for `npm run dev`, and set the same two values in
# Vercel → Project → Settings → Environment Variables.
# Both come from Supabase → Project Settings → API Keys and are safe in the
# browser. Never put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable or anon key>
